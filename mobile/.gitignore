/build/
# `/build/` is anchored to this file, so the per-platform build dirs were not
# covered and ios/build got committed. Match them wherever they appear.
build/
DerivedData/
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/


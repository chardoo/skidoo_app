<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Deep links are handled by app_links → DeepLinkService, not by Flutter's
	     built-in routing. Left enabled, the engine also forwards the URL to the
	     framework as a `pushRoute`, which MaterialApp (Navigator 1.0) turns into
	     pushNamed("/e/<id>") — an unregistered name — so onUnknownRoute pushes
	     DiscoveryPage on top of the screen the link had just opened. See the
	     matching note in AndroidManifest.xml. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>jperg</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>jperg</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.jperg.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jperg</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>jperg needs access to your camera to take photos and scan items.</string>
	<!-- jperg itself never asks for location: nothing in lib/ requests it, and
	     the only permissions the app uses are photos and storage. The key is
	     here because the OneSignal SDK bundles OneSignalLocation, which links
	     CoreLocation, and App Store validation rejects the build (90683) when
	     a framework references those APIs with no purpose string — whether or
	     not the app calls them. It cannot be dropped: onesignal_flutter depends
	     on the OneSignalComplete subspec, and CocoaPods takes the union of
	     subspecs, so asking for the notification-only one in the Podfile leaves
	     OneSignalLocation installed anyway (tried, verified).

	     No prompt will ever be shown, because showing one needs an explicit
	     OneSignal.Location.requestPermission() call that this app does not
	     make. The wording says exactly that, since App Review is the only
	     audience this string will ever have. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>jperg does not use your location. This notice is required because the notification service bundled with the app includes location-based features, which jperg keeps switched off.</string>
	<!-- Same situation as the location key above, and the same rejection
	     (90683). jperg records no audio and no video: the only two cameras it
	     opens are the selfie capture and the face capture, both of which pass
	     `enableAudio: false` precisely so the microphone is never requested —
	     see the note in selfie_capture_screen.dart, where defaulting to true
	     once failed the whole camera initialise when somebody declined a mic
	     prompt on a screen called "Take a Selfie".

	     The key is required anyway because `camera_avfoundation` links
	     AVCaptureDevice's audio APIs to support video recording, and App Store
	     validation rejects a build whose frameworks reference those APIs with
	     no purpose string — whether or not the app calls them. image_picker,
	     mobile_scanner and audio_session are in the same position.

	     No prompt will ever be shown, because nothing in the app asks for
	     microphone access. The wording says exactly that, since App Review is
	     the only audience this string will ever have. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>jperg does not use your microphone and records no audio. This notice is required because the camera library bundled with the app includes video-recording features, which jperg keeps switched off.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>jperg needs permission to save images to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>jperg needs access to your photo library to select and save images.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

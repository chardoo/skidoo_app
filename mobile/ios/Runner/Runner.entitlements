<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links. iOS fetches
	     https://jperg.com/.well-known/apple-app-site-association at install
	     and matches this app's TEAMID.bundle.id against the appIDs in it.

	     Three things have to agree or the link opens Safari with no error
	     anywhere: this domain, the appIDs in that file (IOS_APP_ID, which feeds
	     scripts/gen_wellknown.py), and PRODUCT_BUNDLE_IDENTIFIER in the Xcode
	     project. All three currently say CR97449L96.com.example.jperg.

	     That id looks like a placeholder but is the real, registered one —
	     Apple issued a Store provisioning profile for it under CR97449L96
	     (PICCO TECHNOLOGIES LTD). Apple does not restrict com.example.*; that
	     is Google's rule, and it applies to the Play package, not to this.
	     Changing it here means changing IOS_APP_ID and the deployed AASA in the
	     same breath, or Universal Links silently stop working.

	     `applinks:` alone is enough for links; `webcredentials:` lets a saved
	     password fill in both places. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:jperg.com</string>
		<string>webcredentials:jperg.com</string>
	</array>
</dict>
</plist>

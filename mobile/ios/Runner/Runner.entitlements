<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets a notification be drawn as coming from a person: their face,
	     round, with the app icon badged over its corner.

	     On the app and **only** the app, even though it is the notification
	     service extension that builds the intent. The permission belongs to
	     the bundle the notification is addressed to, not to whichever process
	     rewrote it on the way in, and Apple does not offer this entitlement
	     for app-extension identifiers at all — asking for it on the extension
	     gets the profile refused outright:

	       Entitlement com.apple.developer.usernotifications.communication
	       not found and could not be included in profile.

	     Must also be ticked on the App ID in the developer portal; automatic
	     signing does that for you the first time it builds. See
	     docs/NOTIFICATION_AVATARS.md in the backend repo. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:jperg.com</string>
		<string>webcredentials:jperg.com</string>
	</array>
</dict>
</plist>

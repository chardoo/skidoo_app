platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Fix gRPC-Core and gRPC-C++ basic_seq.h: Apple Clang 15+ requires an explicit
  # template argument list after the `template` keyword in dependent contexts.
  ['gRPC-Core', 'gRPC-C++'].each do |pod_name|
    basic_seq = File.join(__dir__, "Pods/#{pod_name}/src/core/lib/promise/detail/basic_seq.h")
    if File.exist?(basic_seq)
      content = File.read(basic_seq)
      patched = content.gsub(
        'Traits::template CallSeqFactory(',
        'Traits::template CallSeqFactory<>('
      )
      File.write(basic_seq, patched) if patched != content
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Fix Xcode 16 explicit-modules / CFNetwork scan failures.
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      # Raise minimum deployment target so older pods stop warning.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # GoogleMLKit 4.x ships no arm64 simulator slice; exclude arm64 so the
      # simulator builds as x86_64 and Rosetta 2 handles it on Apple Silicon.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
  end

  # Mirror the arm64 simulator exclusion on the Runner target so app and pods agree.
  installer.aggregate_targets.each do |agg|
    agg.user_project.targets.each do |t|
      t.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = '$(inherited) arm64'
      end
    end
    agg.user_project.save
  end
end

# Exclude previous local builds — Docker builds its own inside the container.
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages

# iOS / Android / macOS / Windows / Linux native targets — not needed for web.
mobile/ios/
mobile/android/
mobile/macos/
mobile/windows/
mobile/linux/

# Backend
picco-v2/node_modules/
picco-v2/dist/

# Git
.git/
.gitignore
